      "id": "e2013869-55a9-4015-b367-ccaa978a4106",
      "name": "Normalize Meeting Request"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "ced91ef5-ae74-42a6-ad3d-6ab7b00ebbcd",
              "leftValue": "={{ $json.request_id_is_string && /^[A-Za-z0-9_-]{8,100}$/.test($json.request_id) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            },
            {
              "id": "6a15fc3b-8d83-4a05-8da7-44c0e9d6f816",
              "leftValue": "={{ $json.title_is_string && $json.meeting_title.length >= 2 && $json.meeting_title.length <= 120 }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            },
            {
              "id": "427b40ff-d201-4533-ad65-0a475c901398",
              "leftValue": "={{ /^\\d{4}-\\d{2}-\\d{2}$/.test($json.date) && !isNaN(Date.parse($json.date)) && new Date($json.date).toISOString().slice(0,10) === $json.date }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            },
            {
              "id": "0a070d1d-dc78-465b-8a51-640dd9b89786",
              "leftValue": "={{ $json.transcript_is_string && $json.transcript.length >= 20 && $json.transcript.length <= 50000 }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
